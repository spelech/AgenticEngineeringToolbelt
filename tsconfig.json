{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.mts",
    "templates/vitepress/.vitepress/**/*.ts",
    "templates/vitepress/.vitepress/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "docs/.vitepress/cache",
    "docs/.vitepress/dist",
    "templates/vitepress/.vitepress/cache",
    "templates/vitepress/.vitepress/dist"
  ]
}
